{
  "name": "debonaire-dealership-reporting",
  "private": true,
  "description": "Debonaire dealership returns: PHP API, Next.js UI and Node.js summary CLI (technical exercise).",
  "workspaces": [
    "shared",
    "cli",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && composer install --working-dir=api && npm run seed",
    "seed": "php api/database/seed.php",
    "seed:fresh": "php api/database/seed.php --fresh",
    "dev": "concurrently --names api,web --prefix-colors red,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd api && PHP_CLI_SERVER_WORKERS=4 php -S 127.0.0.1:8000 public/index.php",
    "dev:web": "npm run dev --workspace web",
    "summary": "tsx cli/src/main.ts",
    "test": "npm run test:php",
    "test:php": "cd api && vendor/bin/phpunit",
    "test:ts": "vitest run",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p cli && tsc --noEmit -p web"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
